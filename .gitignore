# ==========================================
# KnowledgeGraph v4.0 — .gitignore
# ==========================================

# ── Python Runtime ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Build & Distribution ────────────────────
build/
dist/
*.egg-info/
*.egg
wheels/

# ── Virtual Environment ────────────────────
venv/
env/
.venv/
*.venv/

# ── IDE / Editor ───────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Runtime Data (数据库、向量索引、模型缓存) ──
backend/data/**
!backend/data/.gitkeep
!backend/data/lancedb/
!backend/data/lancedb/.gitkeep
!backend/data/models/
!backend/data/models/.gitkeep

# ── Uploaded Files ─────────────────────────
backend/inputs/files/**
!backend/inputs/files/
!backend/inputs/files/.gitkeep

# ── Environment & Secrets ──────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# ── Frontend ───────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Logs & Cache ───────────────────────────
*.log
logs/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.db-journal

# ── Testing ────────────────────────────────
.coverage
htmlcov/
.coverage.*

# ── Jupyter ────────────────────────────────
.ipynb_checkpoints/

# ── OS ─────────────────────────────────────
Desktop.ini
$RECYCLE.BIN/

# ── Temporary ──────────────────────────────
*.tmp
*.temp
tmp/
temp/
