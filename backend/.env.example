# ============================================================
# KnowledgeGraph v2.0 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# DeepSeek V4 API 配置 (必填)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Embedding 模型 (本地 BGE)
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=512

# Reranker 模型 (本地 BGE)
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8013
LOG_LEVEL=INFO

# LLM 参数
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# GraphRAG 配置
GRAPHRAG_INPUT_DIR=input
GRAPHRAG_CACHE_DIR=cache
GRAPHRAG_STORAGE_DIR=inputs/artifacts
GRAPHRAG_REPORTING_DIR=inputs/reports
GRAPHRAG_PROMPTS_DIR=prompts
COMMUNITY_LEVEL=2

# 分块参数
CHUNK_SIZE=800
CHUNK_OVERLAP=100
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300

# 提示词文件路径
GRAPHRAG_ENTITY_EXTRACTION_PROMPT_FILE=prompts/entity_extraction.txt
GRAPHRAG_SUMMARIZE_DESCRIPTIONS_PROMPT_FILE=prompts/summarize_descriptions.txt
GRAPHRAG_CLAIM_EXTRACTION_PROMPT_FILE=prompts/claim_extraction.txt
GRAPHRAG_COMMUNITY_REPORT_PROMPT_FILE=prompts/community_report.txt

# 检索配置
HYBRID_SEARCH_TOP_K=20
RERANK_TOP_K=5
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
