# ============================================================
# KnowledgeGraph v4.0 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================================

# ── DeepSeek V4 API 配置（必填）───────────────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ── Embedding 模型（本地 BGE）─────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32

# ── Reranker 模型（本地 BGE）──────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# ── 服务器配置 ───────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8013
LOG_LEVEL=INFO

# ── LLM 参数 ─────────────────────────────────────────────────
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3

# ── 分块参数 ─────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300

# ── 文件上传限制 ─────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
ENABLE_FILE_DEDUP=true

# ── 并发控制 ─────────────────────────────────────────────────
MAX_CONCURRENT_DOC_PROCESSING=3
DOC_PROCESSING_TIMEOUT=30
CPU_WORKER_THREADS=2

# ── 检索引擎配置 ─────────────────────────────────────────────
LANCEDB_PATH=data/lancedb
INDEX_PERSIST_INTERVAL=0

# ── GraphRAG Phase 1：图检索与社区检测 ───────────────────────
GRAPH_TRAVERSAL_MAX_HOPS=3
GRAPH_TRAVERSAL_MAX_NODES=50
GRAPH_TRAVERSAL_STRATEGY=bfs
GRAPH_COMMUNITY_MIN_SIZE=3
GRAPH_ENTITY_RESOLUTION_THRESHOLD=0.85
GRAPH_GLOBAL_SEARCH_TOP_COMMUNITIES=5
GRAPH_RETRIEVAL_WEIGHT=0.3

# ── Phase 2：Agent 配置 ─────────────────────────────────────
AGENT_MAX_STEPS=6
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2048
AGENT_MEMORY_MAX_TURNS=5

# ── 检索配置 ─────────────────────────────────────────────────
HYBRID_SEARCH_TOP_K=20
RERANK_TOP_K=5
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ── 知识图谱配置 ─────────────────────────────────────────────
ENTITY_WEIGHT_THRESHOLD=0.02
MAX_ENTITIES=30
MAX_RELATIONSHIPS=40
BRIDGE_EDGE_DIVISOR=3
BRIDGE_MIN_SIMILARITY=0.15

# ── RAG 增强配置 ─────────────────────────────────────────────
ENABLE_QUERY_REWRITING=false
ENABLE_GRAPH_RAG=true
GRAPH_RAG_EXPAND_ENTITIES=3
SEARCH_CACHE_SIZE=128
SEARCH_CACHE_TTL=60
CONTEXT_MAX_SOURCES=8

# ── v3.2: 联网搜索配置 ────────────────────────────────────────
# DuckDuckGo 免费搜索（无需 Key），也可配置 Tavily API Key
TAVILY_API_KEY=

# ── 图像处理配置（Q3 多模态）───────────────────────────────────
# 无需额外配置 — 使用本地 PaddleOCR + BLIP 模型

# ── 知识覆盖诊断配置（Q9）─────────────────────────────────────
# 分类关键词映射表在 analytics_service.py 中维护

# ── 数据路径（通常无需修改）──────────────────────────────────
DATA_DIR=data
LOCAL_DATA_DIR=inputs/files
DATABASE_URL=sqlite+aiosqlite:///data/knowledge_graph.db
