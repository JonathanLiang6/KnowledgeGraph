# 知识图谱系统环境变量配置

# 智谱AI API配置
GRAPHRAG_API_BASE=https://open.bigmodel.cn/api/paas/v4
GRAPHRAG_CHAT_API_KEY=your-api-key-here
GRAPHRAG_CHAT_MODEL=glm-4-flash
GRAPHRAG_EMBEDDING_MODEL=embedding-2

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8012
LOG_LEVEL=INFO

# LLM参数
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=20

# GraphRAG配置
GRAPHRAG_INPUT_DIR=input
GRAPHRAG_CACHE_DIR=cache
GRAPHRAG_STORAGE_DIR=inputs/artifacts
GRAPHRAG_REPORTING_DIR=inputs/reports
GRAPHRAG_PROMPTS_DIR=prompts
COMMUNITY_LEVEL=2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
